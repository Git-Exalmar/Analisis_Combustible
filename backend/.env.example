# Copiar como .env (NO se sube a git) y completar.
DB_SERVER=exalmar-rg-qas.database.windows.net
DB_NAME=BD_TEL_FLOTA_PRD
DB_USER=
DB_PASS=

PORT=3000
# Origen del frontend permitido (CORS). En desarrollo, Vite usa el 5173.
CORS_ORIGIN=http://localhost:5173

# Minutos sin datos a partir de los cuales una embarcación se muestra "sin datos"
LIMITE_SIN_DATOS_MIN=60
# Cada cuántos segundos el SSE revisa si hubo un proceso de scoring nuevo
INTERVALO_SSE_SEG=30

# SOLO PARA DEMO: fija la hora "actual" (hora de Perú) para usar los datos repetidos de temporada.
# En producción se deja vacío.
AHORA_FIJO=2026-04-25T14:00:00
